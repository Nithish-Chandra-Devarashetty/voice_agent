# Copy to .env for local runs. For LiveKit Cloud, copy to .env.cloud and delete
# the three LIVEKIT_ lines (the cloud provides them).

# --- LiveKit (local runs only) ---
LIVEKIT_URL=wss://dasco-motors-nem721pv.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram: the agent's voice (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=
# Aura-2 English voices: aura-2-thalia-en, aura-2-andromeda-en, aura-2-apollo-en...
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Speechmatics: speech-to-text with speaker diarization (https://portal.speechmatics.com) ---
# The agent locks onto the caller's voice and ignores other voices in the room.
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=en

# --- LLM: Claude Haiku 5.5 (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Thinking off at low effort starts replying in about a second (measured); "on" is slower.
LLM_EFFORT=low
LLM_THINKING=off
LLM_MAX_TOKENS=1024

# --- The agent ---
# The phone number's dispatch rule must use this name.
AGENT_NAME=dasco-v3
DEALERSHIP_NAME=PASCO Motors
SHOWROOM_OPEN_HOUR=9
SHOWROOM_CLOSE_HOUR=21
SILENCE_HANGUP_SECONDS=30

# Bookings and leads are POSTed here as JSON (optional; always saved to data/ too).
WEBHOOK_URL=
